let mDerecha = [];
let spring = [];
let f;
let s;
let tempo;
let fondo;
let fondox;

function preload() {
  for (let i = 0; i < 3; i++) {
    mDerecha[i] = loadImage("assets/MoverDerecha/mover" + i + ".png");
  } // <-- Faltaba cerrar esta llave


  for (let i = 0; i < 4; i++) {
    spring[i] = loadImage("assets/spring/spring" + i + ".png");
  }

  fondo = loadImage("assets/fondo/fondo.jfif");
}

function setup() {
  createCanvas(800, 400);
  noSmooth();
  f = 0;
  s = 0;
  tempo = millis();
  fondox = 0;
}

function draw() {
  background(125);

  // Fondo infinito
  image(fondo, fondox, 0, 2000, 400);
  image(fondo, fondox + 2000, 0, 2000, 400);

  fondox -= 1;

  if (fondox <= -2000) {
    fondox = 0;
  }

  // Dibujar personajes
  image(mDerecha[f], 250, 200, 50, 80);
  image(spring[s], 25, 140, 55, 150);

  // Un solo temporizador actualiza los fotogramas de ambos personajes al mismo tiempo
  if (millis() - tempo >= 200) {
    f++;
    s++;
    tempo = millis();
  }

  if (f >= 3) f = 0;
  if (s >= 4) s = 0; // Son 4 frames (0, 1, 2, 3)

  // Coordenadas del mouse
  fill(0);
  textSize(20);
  text(mouseX + " " + mouseY, mouseX, mouseY);
}
